# ============================================
# BookScrapper — Environment Variables
# ============================================
# Copiază acest fișier ca .env și completează valorile.

# --- Vercel KV (Upstash Redis) ---
# Necesar pentru cache și rate limiting.
# Poți crea un database gratuit la https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_token_here